{
  "name": "3DDUT AR — tu diseño, parado en la obra",
  "short_name": "3DDUT AR",
  "description": "Visualizá cualquier modelo OBJ de tu CAD en realidad aumentada, in situ, a escala real o como maqueta.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#F3F5F7",
  "theme_color": "#FF6A13",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./recibir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "modelo",
          "accept": [
            "model/obj",
            "application/json",
            "application/octet-stream",
            "text/plain",
            ".obj",
            ".mtl",
            ".json",
            ".stl"
          ]
        }
      ]
    }
  }
}